{
  "manifest_version": 3,
  "name": "Omarchy Apple Music Bridge",
  "version": "1.0.0",
  "description": "Publishes the Apple Music queue (previous/next) to the Omarchy bar.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://music.apple.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://music.apple.com/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://music.apple.com/*"], "js": ["relay.js"], "run_at": "document_idle" }
  ]
}
